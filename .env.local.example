# Copy this file to .env.local and fill in your Supabase project credentials
# (Project Settings -> API in the Supabase dashboard). Without them the app
# serves the bundled seed catalogue from src/data/seed.json.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sign-in providers are configured in the Supabase dashboard, not here:
#   Authentication -> Providers -> Google  (add http://localhost:3000/auth/callback
#                                           and your prod URL as redirect URLs)
#   Authentication -> Providers -> Email   (enable "Email OTP")
#   Authentication -> Providers -> Phone   (needs an SMS provider, e.g. Twilio)
